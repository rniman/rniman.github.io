---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import ProjectDetails from '../../components/ProjectDetails.astro';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<Base title={project.title} description={project.description}>
  <article class="article">
    <a class="back-link" href="/projects/">← 프로젝트 목록</a>
    <header class="article-heading"><p class="eyebrow">{project.category}</p><h1>{project.title}</h1><p>{project.description}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div></header>
    {project.lifecycle ? <div class="prose">
      <h2>프로젝트 소개</h2><p>{project.intro}</p>
      <aside class="notice"><strong>{project.lifecycle.status}</strong><p>{project.lifecycle.note}</p></aside>
      {project.archiveSummary && <>
        <h2>구현한 내용</h2>
        <ul>{project.archiveSummary.features.map(feature => <li>{feature}</li>)}</ul>
        <h2>짧은 회고</h2>
        {project.archiveSummary.retrospective.map(paragraph => <p>{paragraph}</p>)}
        <h2>다음 프로젝트로 이어갈 점</h2>
        <p>{project.archiveSummary.next}</p>
        <h2>보존과 실행</h2>
        <p>{project.archiveSummary.baseline}</p>
      </>}
      <h2>관련 프로젝트와 소스 코드</h2>
      <ul>{project.lifecycle.links.map(link => <li><a href={link.href}>{link.label} {link.href.startsWith('https://') ? '↗' : '→'}</a></li>)}</ul>
    </div> : project.details ? <ProjectDetails intro={project.intro} details={project.details} /> : <div class="prose"><h2>프로젝트 소개</h2><p>{project.intro}</p><h2>다루는 주제</h2><ul>{project.topics.map(topic => <li>{topic}</li>)}</ul>
      <aside class="notice"><strong>개발 기록을 정리하고 있습니다.</strong><p>구체적인 담당 범위, 구현 과정과 실행 화면은 자료를 정리한 뒤 추가할 예정입니다.</p></aside>
      <h2>관련 채널</h2><p><a href="https://github.com/rniman">GitHub 프로필 ↗</a>에서 공개 저장소를, <a href="https://velog.io/@rniman/posts">Velog ↗</a>에서 개발 기록을 확인할 수 있습니다.</p>
    </div>}
  </article>
</Base>
