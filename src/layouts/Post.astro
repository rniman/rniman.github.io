---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="article"><a class="back-link" href="/notes/">← 개발 기록 목록</a>
    <header class="article-heading"><p class="eyebrow">{frontmatter.category} / <time datetime={frontmatter.date}>{frontmatter.date}</time></p><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p></header>
    <div class="prose"><slot /></div>
    <div class="article-end"><a href="/notes/">← 다른 기록 보기</a><a href="https://velog.io/@rniman/posts">Velog ↗</a></div>
  </article>
</Base>
